# Local development configuration only.
PORT=3000
DATABASE_FILE=./data/pharmarchy.sqlite

# Optional path to a validated, non-secret public storefront configuration file.
STOREFRONT_CONFIG_FILE=./config/storefront.json

# Used only when NODE_ENV is not production to seed the fictional demo pharmacist.
# Never use this account, password, or SQLite data for a real pharmacy deployment.
DEMO_STAFF_PASSWORD=DemoPharmarchyReview2026!

# Set to production only after implementing the launch gates in IMPLEMENTATION_BACKLOG.md.
# Production skips demo catalog/staff seeding, suppresses demo rows, and disables an already-seeded demo account.
# NODE_ENV=production
